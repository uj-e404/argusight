# ArguSight Configuration
PORT=4959
NODE_ENV=production
CONFIG_PATH=/app/config
COOKIE_SECURE=false          # Set to 'true' if behind HTTPS reverse proxy

# SSH Keys directory (mounted read-only into container)
SSH_KEY_DIR=~/.ssh

# Server passwords (referenced in servers.json as "$ENV:SSH_PASS_SERVER1")
# SSH_PASS_SERVER1=your_password_here
